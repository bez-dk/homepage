# Copy to .env to change the Docker settings (all optional).

WEB_PORT=8080
DB_PORT=3306
MAIL_PORT=8025

DB_NAME=homepage
DB_USER=homepage
DB_PASSWORD=homepage
DB_ROOT_PASSWORD=root

# Open http://localhost:8080/admin, choose a password and paste the hash here.
# Keep the single quotes: the hash contains $ signs.
ADMIN_PASSWORD_HASH=''
